                        "readOnly": true
                    }
                }
            },
            "v202611SuppressionServiceReplaceResponse": {
                "type": "object",
                "properties": {
                    "suppression": {
                        "$ref": "#/components/schemas/v202611Suppression"
                    }
                }
            },
            "v202611TimestampSetting": {
                "type": "string",
                "enum": [
                    "TIMESTAMP_SETTING_UNSPECIFIED",
                    "TIMESTAMP_SETTING_KEEP_UNCHANGED",
                    "TIMESTAMP_SETTING_AS_SOON_AS_POSSIBLE"
                ],
                "default": "TIMESTAMP_SETTING_UNSPECIFIED",
                "description": "Timestamp commands are inputs, not persisted commands to replay on a later write.\nUnknown enum values are invalid.\n\n - TIMESTAMP_SETTING_UNSPECIFIED: Use the explicit timestamp, or its documented default when omitted.\n - TIMESTAMP_SETTING_KEEP_UNCHANGED: Preserve the stored timestamp, including an indefinite end. Replace only.\n - TIMESTAMP_SETTING_AS_SOON_AS_POSSIBLE: Request the earliest permitted time, subject to propagation and window constraints."
            }
        }
    }
}
