            "v202611SuppressionServiceListResponse": {
                "type": "object",
                "properties": {
                    "pagination": {
                        "$ref": "#/components/schemas/typesv202506PaginationInfo"
                    },
                    "suppressions": {
                        "type": "array",
                        "items": {
