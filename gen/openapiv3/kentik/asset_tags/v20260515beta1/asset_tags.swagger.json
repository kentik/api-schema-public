                "summary": "Gets tag values by asset id and type.",
                "description": "Returns a list of tag values.",
                "operationId": "GetTagValues",
                "responses": {
                    "200": {
                        "description": "A successful response.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/v20260515beta1GetTagValuesResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "An unexpected error response.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/rpcStatus"
                                }
                            }
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "assetType",
                        "description": "Asset type",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "ASSET_TYPE_UNSPECIFIED",
                                "ASSET_TYPE_DEVICE"
                            ]
                        }
                    },
                    {
                        "name": "assetId",
                        "description": "Asset id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "tags": [
                    "AssetTagsService"
                ]
            }
        },
