{
  "swagger": "2.0",
  "info": {
    "title": "KAgent Config API",
    "description": "Management of Kentik Agent capability configurations: creation, retrieval, modification and deletion.\n",
    "version": "v202401",
    "contact": {
      "name": "Kentik API Engineering",
      "url": "https://github.com/kentik/api-schema-public"
    }
  },
  "tags": [
    {
      "name": "ConfigService"
    }
  ],
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/kagent/v202401/config": {
      "post": {
        "summary": "Create a config.",
        "description": "Creates a new config based on the request and returns it.",
        "operationId": "CreateConfig",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v202401CreateConfigResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "config",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v202401Config",
              "description": "Config configuration.",
              "required": [
                "config"
              ]
            }
          }
        ],
        "tags": [
          "ConfigService"
        ]
      }
    },
    "/kagent/v202401/config/{config.name}": {
      "patch": {
        "summary": "Update a config.",
        "description": "Updates the attributes of a config selected by the field mask in the request.",
        "operationId": "UpdateConfig",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v202401UpdateConfigResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "config.name",
            "description": "Name of the config.",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ConfigServiceUpdateConfigBody"
            }
          }
        ],
        "tags": [
          "ConfigService"
        ]
      },
      "get": {
        "summary": "Get a config.",
        "description": "Returns the config with the specified name.",
        "operationId": "GetConfig",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v202401GetConfigResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "config.name",
            "description": "Name of the config to be retrieved.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ConfigService"
        ]
      },
      "delete": {
        "summary": "Delete a config.",
        "description": "Deletes the config with the specified name.",
        "operationId": "DeleteConfig",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v202401DeleteConfigResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "config.name",
            "description": "Name of the config to be deleted.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ConfigService"
        ]
      }
    }
  },
  "definitions": {
    "ConfigLayerLayerType": {
      "type": "string",
      "enum": [
        "LAYER_TYPE_UNSPECIFIED",
        "LAYER_TYPE_SEED",
        "LAYER_TYPE_GROUP",
        "LAYER_TYPE_AGENT"
      ],
      "default": "LAYER_TYPE_UNSPECIFIED",
      "description": "- LAYER_TYPE_UNSPECIFIED: Invalid value.\n - LAYER_TYPE_SEED: seed config\n - LAYER_TYPE_GROUP: capability group config\n - LAYER_TYPE_AGENT: agent config",
      "title": "LayerType"
    },
    "ConfigServiceUpdateConfigBody": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "capability": {
              "type": "string",
              "description": "Name of the capability the config applies to."
            },
            "version": {
              "type": "string",
              "description": "Version of the config, generated by the server.",
              "title": "config version is generated by the server",
              "readOnly": true
            },
            "runtime": {
              "$ref": "#/definitions/v202401RuntimeConfig",
              "description": "Runtime configuration of the capability process."
            },
            "telemetry": {
              "$ref": "#/definitions/v202401TelemetryConfig",
              "description": "Telemetry configuration, generated by the server.",
              "title": "telemetry config is generated by the server",
              "readOnly": true
            },
            "layers": {
              "type": "array",
              "items": {
                "type": "object",
                "$ref": "#/definitions/v202401ConfigLayer"
              },
              "description": "Layers the config is composed of, in order of increasing precedence.",
              "title": "config layers, seed, group, agent",
              "readOnly": true
            }
          },
          "title": "Config"
        },
        "mask": {
          "type": "string",
          "description": "Attributes of the config to be updated. Attributes not listed keep their current value."
        }
      },
      "title": "UpdateConfigRequest",
      "required": [
        "config",
        "mask"
      ]
    },
    "RuntimeConfigEnvVar": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the environment variable."
        },
        "value": {
          "type": "string",
          "description": "Value of the environment variable."
        },
        "origin": {
          "type": "string",
          "description": "Config layer that provided this variable.",
          "title": "indicates the config layer that provided this variable"
        }
      },
      "title": "EnvVar"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v202401Config": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the config."
        },
        "capability": {
          "type": "string",
          "description": "Name of the capability the config applies to."
        },
        "version": {
          "type": "string",
          "description": "Version of the config, generated by the server.",
          "title": "config version is generated by the server",
          "readOnly": true
        },
        "runtime": {
          "$ref": "#/definitions/v202401RuntimeConfig",
          "description": "Runtime configuration of the capability process."
        },
        "telemetry": {
          "$ref": "#/definitions/v202401TelemetryConfig",
          "description": "Telemetry configuration, generated by the server.",
          "title": "telemetry config is generated by the server",
          "readOnly": true
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v202401ConfigLayer"
          },
          "description": "Layers the config is composed of, in order of increasing precedence.",
          "title": "config layers, seed, group, agent",
          "readOnly": true
        }
      },
      "title": "Config"
    },
    "v202401ConfigLayer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the layer."
        },
        "type": {
          "$ref": "#/definitions/ConfigLayerLayerType",
          "description": "Type of the layer.",
          "readOnly": true
        }
      },
      "title": "ConfigLayer"
    },
    "v202401CreateConfigResponse": {
      "type": "object",
      "properties": {
        "config": {
          "$ref": "#/definitions/v202401Config",
          "description": "Created config object."
        }
      },
      "title": "CreateConfigResponse"
    },
    "v202401DeleteConfigResponse": {
      "type": "object",
      "title": "DeleteConfigResponse"
    },
    "v202401GetConfigResponse": {
      "type": "object",
      "properties": {
        "config": {
          "$ref": "#/definitions/v202401Config",
          "description": "Config object."
        }
      },
      "title": "GetConfigResponse"
    },
    "v202401RuntimeConfig": {
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Command arguments passed to the process.",
          "title": "command arguments"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/RuntimeConfigEnvVar"
          },
          "description": "Environment variables set for the process.",
          "title": "environment variables"
        },
        "binary": {
          "type": "string",
          "description": "Name of the binary to run.",
          "title": "binary name"
        },
        "linuxCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Linux capabilities added to the process.",
          "title": "linux capabilities that should be added to the process"
        }
      },
      "title": "RuntimeConfig"
    },
    "v202401TelemetryConfig": {
      "type": "object",
      "properties": {
        "logsEndpoint": {
          "type": "string",
          "description": "Endpoint the agent sends logs to."
        },
        "metricsEndpoint": {
          "type": "string",
          "description": "Endpoint the agent sends metrics to."
        },
        "kmetricsEndpoint": {
          "type": "string",
          "description": "Endpoint the agent sends kmetrics to."
        },
        "sentryEndpoint": {
          "type": "string",
          "description": "Endpoint the agent sends crash reports to."
        }
      },
      "title": "TelemetryConfig"
    },
    "v202401UpdateConfigResponse": {
      "type": "object",
      "properties": {
        "config": {
          "$ref": "#/definitions/v202401Config",
          "description": "Updated config object."
        }
      },
      "title": "UpdateConfigResponse"
    }
  },
  "securityDefinitions": {
    "email": {
      "type": "apiKey",
      "name": "X-CH-Auth-Email",
      "in": "header"
    },
    "token": {
      "type": "apiKey",
      "name": "X-CH-Auth-API-Token",
      "in": "header"
    }
  },
  "security": [
    {
      "email": [],
      "token": []
    }
  ],
  "externalDocs": {
    "description": "Kentik Knowledge Base",
    "url": "https://kb.kentik.com/"
  }
}
