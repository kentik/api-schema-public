      "get": {
        "summary": "Gets tag values by asset id and type.",
        "description": "Returns a list of tag values.",
        "operationId": "GetTagValues",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v20260515beta1GetTagValuesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "assetType",
            "description": "Asset type",
            "in": "path",
            "required": true,
            "type": "string",
            "enum": [
              "ASSET_TYPE_UNSPECIFIED",
              "ASSET_TYPE_DEVICE"
            ]
          },
          {
            "name": "assetId",
            "description": "Asset id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "AssetTagsService"
        ]
      }
    },
