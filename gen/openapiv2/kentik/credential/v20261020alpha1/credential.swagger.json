{
  "swagger": "2.0",
  "info": {
    "title": "Credentials Vault API",
    "description": "# Overview\nThe Credentials Vault API enables programmatic lifecycle management of credentials stored in Kentik Credential Vault.\n### Key Features\n* Create, read, update, and delete of credential groups\n* Lookup and deletion of individual credential versions\n* Assignment of consumers (synthetic tests, devices, etc.) to credentials\n\nSecret values are write-only: they are accepted on create and update but never returned.\n",
    "version": "v20261020alpha1",
    "contact": {
      "name": "Kentik API Engineering",
      "url": "https://github.com/kentik/api-schema-public"
    }
  },
  "tags": [
    {
      "name": "CredentialService"
    }
  ],
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/credential/v20261020alpha1/credentials": {
      "get": {
        "summary": "List credentials.",
        "description": "Returns the latest version of every credential.",
        "operationId": "ListCredentials",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v20261020alpha1ListCredentialsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "CredentialService"
        ]
      }
    },
    "/credential/v20261020alpha1/credentials/{name}": {
      "get": {
        "summary": "Get a credential by name.",
        "description": "Returns the latest, a specific, or every version of a credential.",
        "operationId": "GetCredential",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v20261020alpha1GetCredentialResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "description": "Fully qualified credential name, `<group>.<key>`",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "version",
            "description": "Specific version to fetch. Defaults to the latest.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "allVersions",
            "description": "Return every version, newest first",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "CredentialService"
        ]
      }
    },
    "/credential/v20261020alpha1/credentials/{name}/consumer": {
      "put": {
        "summary": "Assign a consumer to a credential.",
        "description": "Records that an entity (synthetic test, device, etc.) uses the credential.",
        "operationId": "AssignConsumer",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v20261020alpha1AssignConsumerResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "description": "Fully qualified credential name, `<group>.<key>`",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CredentialServiceAssignConsumerBody"
            }
          }
        ],
        "tags": [
          "CredentialService"
        ]
      }
    },
    "/credential/v20261020alpha1/credentials/{name}/versions/{version}": {
      "delete": {
        "summary": "Delete a credential version.",
        "description": "Deletes a single version of a credential. Fails if the credential has consumers.",
        "operationId": "DeleteCredential",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v20261020alpha1DeleteCredentialResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "description": "Fully qualified credential name, `<group>.<key>`",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "version",
            "description": "Credential version; versions start at 0",
            "in": "path",
            "required": true,
            "type": "integer",
            "format": "int64"
          }
        ],
        "tags": [
          "CredentialService"
        ]
      }
    },
    "/credential/v20261020alpha1/groups": {
      "get": {
        "summary": "List credential groups.",
        "description": "Returns every credential group with the latest version of its credentials.",
        "operationId": "ListCredentialGroups",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v20261020alpha1ListCredentialGroupsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "CredentialService"
        ]
      },
      "post": {
        "summary": "Create a credential group.",
        "description": "Creates one credential per token and returns the created group.",
        "operationId": "CreateCredentialGroup",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v20261020alpha1CreateCredentialGroupResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v20261020alpha1CreateCredentialGroupRequest"
            }
          }
        ],
        "tags": [
          "CredentialService"
        ]
      }
    },
    "/credential/v20261020alpha1/groups/{name}": {
      "get": {
        "summary": "Get a credential group by name.",
        "description": "Returns a single credential group.",
        "operationId": "GetCredentialGroup",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v20261020alpha1GetCredentialGroupResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "description": "Credential group name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "CredentialService"
        ]
      },
      "delete": {
        "summary": "Delete a credential group.",
        "description": "Deletes every version of every credential in the group. Fails if any credential has consumers.",
        "operationId": "DeleteCredentialGroup",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v20261020alpha1DeleteCredentialGroupResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "description": "Credential group name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "CredentialService"
        ]
      },
      "put": {
        "summary": "Update a credential group.",
        "description": "Tokens with a value create a new credential version; tokens without one only update metadata.",
        "operationId": "UpdateCredentialGroup",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v20261020alpha1UpdateCredentialGroupResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "description": "Credential group name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CredentialServiceUpdateCredentialGroupBody"
            }
          }
        ],
        "tags": [
          "CredentialService"
        ]
      }
    },
    "/credential/v20261020alpha1/overviews": {
      "get": {
        "summary": "List credential group names and types.",
        "description": "Returns a lightweight name and type listing of every credential group, for lookups.",
        "operationId": "ListCredentialOverviews",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v20261020alpha1ListCredentialOverviewsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "CredentialService"
        ]
      }
    }
  },
