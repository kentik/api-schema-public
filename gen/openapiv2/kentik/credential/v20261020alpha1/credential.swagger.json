          },
          "readOnly": true
        }
      },
      "title": "CredentialGroup"
    },
    "v20261020alpha1CredentialOverview": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Credential group name"
        },
        "type": {
          "$ref": "#/definitions/v20261020alpha1CredentialType",
          "description": "Credential type"
        }
      },
      "title": "CredentialOverview"
    },
    "v20261020alpha1CredentialType": {
      "type": "string",
      "enum": [
        "CREDENTIAL_TYPE_UNSPECIFIED",
        "CREDENTIAL_TYPE_BASIC_AUTH",
        "CREDENTIAL_TYPE_SNMP_V1",
        "CREDENTIAL_TYPE_SNMP_V2C",
        "CREDENTIAL_TYPE_SNMP_V3",
        "CREDENTIAL_TYPE_STREAMING_TELEMETRY",
        "CREDENTIAL_TYPE_BGP_MD5",
        "CREDENTIAL_TYPE_API_TOKEN",
        "CREDENTIAL_TYPE_OTHER",
        "CREDENTIAL_TYPE_SSH_KEY",
        "CREDENTIAL_TYPE_SSH_PASSWORD",
        "CREDENTIAL_TYPE_AI_API_TOKEN",
        "CREDENTIAL_TYPE_MCP_HTTP_HEADERS",
        "CREDENTIAL_TYPE_CLOUD"
      ],
      "default": "CREDENTIAL_TYPE_UNSPECIFIED",
      "title": "CredentialType"
