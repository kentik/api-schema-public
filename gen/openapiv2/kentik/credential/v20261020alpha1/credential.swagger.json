          "description": "Pipe-delimited ids of the latest version of each credential in the group"
        },
        "name": {
          "type": "string",
          "description": "Credential group name"
        },
        "version": {
          "type": "integer",
          "format": "int64",
          "description": "Group version"
        },
        "description": {
          "type": "string",
          "description": "Purpose of this credential group"
        },
        "type": {
          "$ref": "#/definitions/v20261020alpha1CredentialType",
          "description": "Credential type"
        },
        "cdate": {
          "type": "string",
          "format": "date-time",
          "readOnly": true
        },
        "edate": {
          "type": "string",
          "format": "date-time",
          "readOnly": true
        },
        "createdBy": {
          "$ref": "#/definitions/v20261020alpha1CreatedBy",
          "readOnly": true
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
